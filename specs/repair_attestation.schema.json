{
  "$id": "https://dataforge.dev/schemas/RepairAttestation/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural schema for the attestation promised at specs/SPEC_repair_attestation.md. GENERATED by scripts/ci/generate_attestation_schema.py from the verifier's own required-field tuples and the closed vocabularies in dataforge/domain/vocabulary.py -- never hand-edited, because a schema written beside a verifier is a second specification that drifts silently.\n\nStructural validity is NECESSARY AND NOT SUFFICIENT. verify_attestation additionally re-derives trust strength from provenance and column authority, checks the subject digest against the data, requires every subject to name the artifact the predicate describes, and verifies the DSSE signature when present. A document that satisfies this schema and fails verification is expected.",
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1",
      "type": "string"
    },
    "predicate": {
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "attestation_version": {
          "const": "1",
          "type": "string"
        },
        "authority": {
          "properties": {
            "accepted_constraint_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "authoritative_columns": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "constraints": {
              "description": "The constraints embedded IN FULL, not by reference. A digest and an id list are dangling pointers: a verifier must be able to read what a fix was proven against without fetching anything, which is what makes offline verification possible. ADVISORY as of 2026-09-16: this is the schema file as authored, for a human to read, and `constraints_present` tests only that it is non-empty. The field a verifier recomputes authority from is `premise`."
            },
            "constraints_digest": {
              "oneOf": [
                {
                  "properties": {
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "sha256"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "premise": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "description": "The declared schema authority was computed from, in the canonical premise format of SPEC section 6.4.1. This is what `authority_is_entailed` recomputes `authoritative_columns` from, so the authority claim is arithmetic a reader can repeat rather than an assertion a reader must accept. `additionalProperties: false` is load-bearing at every level: a premise carrying a constraint this format cannot express would confer authority in-process while understating it here.",
                  "properties": {
                    "accepted_values": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "column": {
                            "type": "string"
                          },
                          "values": {
                            "items": {
                              "type": "string"
                            },
                            "minItems": 1,
                            "type": "array"
                          }
                        },
                        "required": [
                          "column",
                          "values"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "aggregate_dependencies": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "aggregate": {
                            "enum": [
                              "avg",
                              "sum"
                            ],
                            "type": "string"
                          },
                          "group_by": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "source_column": {
                            "type": "string"
                          },
                          "target_column": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source_column",
                          "target_column",
                          "aggregate"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "columns": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "domain_bounds": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "column": {
                            "type": "string"
                          },
                          "inclusive_max": {
                            "type": "boolean"
                          },
                          "inclusive_min": {
                            "type": "boolean"
                          },
                          "max_value": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "min_value": {
                            "type": [
                              "number",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "column"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "functional_dependencies": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "dependent": {
                            "type": "string"
                          },
                          "determinant": {
                            "items": {
                              "type": "string"
                            },
                            "minItems": 1,
                            "type": "array"
                          }
                        },
                        "required": [
                          "determinant",
                          "dependent"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "not_null_columns": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "pii_columns": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "premise_format": {
                      "const": "dataforge.premise/v1",
                      "type": "string"
                    },
                    "primary_key_columns": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "regex_constraints": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "column": {
                            "type": "string"
                          },
                          "pattern": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "column",
                          "pattern"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "relationships": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "column": {
                            "type": "string"
                          },
                          "reference": {
                            "type": "string"
                          },
                          "reference_column": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "column",
                          "reference",
                          "reference_column"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "unique_columns": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "premise_format"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "authoritative_columns",
            "accepted_constraint_ids"
          ],
          "type": "object"
        },
        "fixes": {
          "items": {
            "properties": {
              "column": {
                "minLength": 1,
                "type": "string"
              },
              "detector_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "new_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "old_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "enum": [
                  "deterministic",
                  "entity_consensus",
                  "external",
                  "llm_cache",
                  "llm_live"
                ],
                "minLength": 1,
                "type": "string"
              },
              "row": {
                "minimum": 0,
                "type": "integer"
              },
              "verification_strength": {
                "description": "Re-derived by the verifier from provenance and column authority. A recorded value stronger than the derivation is a REJECT; a recorded plausibility_only is always believed.",
                "enum": [
                  "plausibility_only",
                  "proven"
                ],
                "type": "string"
              },
              "witness": {
                "description": "The evidence this constraint-derived write rested on, as data. Values are published as sha256(value)[:16], never in plaintext: the predicate deliberately carries no cell values, and a witness stating a group's distribution in the clear would turn a shareable document into a data-disclosure vector. Hashing costs nothing that matters -- a third party HOLDING THE TABLE hashes their own group and compares counts, in SQL or any language, with no DataForge code, so the derivation stays fully checkable without trusting our labelling rule; a party without the table learns only the shape.\n\nThe normative verifier checks this block's INTERNAL COHERENCE (support is a strict majority of group_size, the written value's count equals its support, counts sum to group_size unless truncation is declared). It does not recompute from the data, which would make the verifier a CSV parser and force two implementations to agree byte-for-byte on quoting and line endings.",
                "properties": {
                  "constraint": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "constraint_kind": {
                    "enum": [
                      "functional_dependency"
                    ],
                    "type": "string"
                  },
                  "determinant_columns": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "determinant_digests": {
                    "items": {
                      "pattern": "^[0-9a-f]{16}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "group_size": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "new_value_digest": {
                    "pattern": "^[0-9a-f]{16}$",
                    "type": "string"
                  },
                  "old_value_digest": {
                    "pattern": "^[0-9a-f]{16}$",
                    "type": "string"
                  },
                  "support": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "value_digests": {
                    "items": {
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "pattern": "^[0-9a-f]{16}$",
                          "type": "string"
                        },
                        {
                          "minimum": 0,
                          "type": "integer"
                        }
                      ],
                      "type": "array"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "constraint",
                  "constraint_kind",
                  "group_size",
                  "support",
                  "value_digests",
                  "new_value_digest"
                ],
                "type": "object"
              }
            },
            "required": [
              "row",
              "column",
              "provenance",
              "verification_strength"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "held": {
          "items": {
            "properties": {
              "column": {
                "type": "string"
              },
              "review_reason": {
                "enum": [
                  "ambiguous_fd",
                  "failed_conformal_threshold",
                  "floor_cannot_verify",
                  "inferred_fd_not_declared",
                  "invalid_target",
                  "mined_constraint_not_declared",
                  "not_inferable_from_data",
                  "out_of_inferred_domain",
                  "safety_denied",
                  "safety_escalation",
                  "stale_precondition",
                  "unverified_entity_consensus",
                  "unverified_transposition",
                  "verifier_rejected"
                ],
                "type": "string"
              },
              "row": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "journal": {
          "properties": {
            "head_sha256": {
              "oneOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "txn_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "apply",
            "dry_run"
          ],
          "type": "string"
        },
        "model": {
          "description": "Provider and model identity when any fix is LLM-origin; null otherwise. Declared `string | null` until 2026-09-16, which contradicted both SPEC section 6.2 and `build_attestation`, whose emitted value is `dict(model)`. No vector caught it because every vector sets model to null.",
          "type": [
            "object",
            "null"
          ]
        },
        "post": {
          "oneOf": [
            {
              "description": "The post-repair artifact. Null on a dry run.",
              "properties": {
                "digest": {
                  "properties": {
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "sha256"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "digest"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "produced_at": {
          "format": "date-time",
          "type": "string"
        },
        "reversible": {
          "type": "boolean"
        },
        "revert_command": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The pre-repair artifact.",
          "properties": {
            "digest": {
              "properties": {
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "sha256"
              ],
              "type": "object"
            }
          },
          "required": [
            "digest"
          ],
          "type": "object"
        },
        "tool": {
          "properties": {
            "contract_version": {
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "type": "object"
        },
        "verdicts": {
          "properties": {
            "independent_verification": {
              "enum": [
                "agreed",
                "not_run"
              ],
              "type": "string"
            },
            "safety": {
              "enum": [
                "allow",
                "deny",
                "escalate"
              ],
              "type": "string"
            },
            "verifier": {
              "enum": [
                "accept",
                "not_run",
                "reject",
                "unknown"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "verification": {
          "properties": {
            "checks_available": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "tool",
        "produced_at",
        "mode",
        "applied",
        "reversible",
        "source",
        "authority",
        "fixes",
        "held",
        "verdicts",
        "journal",
        "limitations"
      ],
      "type": "object"
    },
    "predicateType": {
      "const": "https://dataforge.dev/RepairAttestation/v1",
      "type": "string"
    },
    "subject": {
      "description": "in-toto permits N subjects. Every subject must name the artifact the predicate describes: duplicates are allowed, and a subject naming a different artifact is a REJECT. Reading only subject[0] -- which both verifiers did until 2026-08-29 -- let a valid attestation be extended with a subject nobody attested.",
      "items": {
        "properties": {
          "digest": {
            "properties": {
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "sha256"
            ],
            "type": "object"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "digest"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "title": "DataForge repair attestation (in-toto statement)",
  "type": "object"
}
